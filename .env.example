# Public DNS name terminated by Caddy. Do not include a scheme.
MCP_DOMAIN=mcp.example.com

NODE_ENV=production
DEPLOYMENT_PROFILE=alpic-metadata
HOST=0.0.0.0
PORT=8000
NPLG_BASE_URL=https://dspace.nplg.gov.ge/
PUBLIC_BASE_URL=https://mcp.example.com
CACHE_DIR=/data/cache

# Replace every placeholder before deployment. Credentials are bound to stable
# principal IDs; add separate entries instead of sharing one credential.
ASSET_SIGNING_SECRET=replace-with-at-least-32-random-characters
API_PRINCIPALS_JSON=[{"principal_id":"primary","bearer_token":"replace-with-at-least-32-random-characters"}]
ALLOW_ANONYMOUS=false

MAX_DOWNLOAD_BYTES=536870912
MAX_RENDER_PAGES=8
MAX_PAGE_PIXELS=120000000
MAX_RENDER_PIXELS=480000000
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_BODY_TIMEOUT_SECONDS=10
PDF_EXECUTOR=serialized
PRIVATE_EDGE_TLS=false
MAX_CONCURRENT_PDF_JOBS=1
MAX_CONCURRENT_MCP_REQUESTS=16
MAX_CONCURRENT_MCP_REQUESTS_PER_PRINCIPAL=4
MAX_CONCURRENT_ASSET_STREAMS=8
ASSET_STREAM_IDLE_TIMEOUT_SECONDS=10
ASSET_STREAM_TOTAL_TIMEOUT_SECONDS=120
MAX_CONCURRENT_HTTP_REQUESTS=128
CACHE_MAX_BYTES=21474836480

TILE_WIDTH=2048
TILE_HEIGHT=2048
TILE_OVERLAP=128
ASSET_TTL_SECONDS=3600

UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_RATE_PER_SECOND=1.0
MAX_REDIRECTS=3
