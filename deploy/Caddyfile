{
    admin off
    auto_https on
}

{$MCP_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 1MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Metrics remain reachable only on the private application network.
    @private_metrics path /metrics
    respond @private_metrics 404

    # Probes are for container/orchestrator checks, not the public Internet.
    @private_probes path /healthz /readyz
    respond @private_probes 404

    reverse_proxy app:8000 {
        health_uri /healthz
        health_interval 30s
        health_timeout 5s
    }

}
